{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jpeg-pot",
  "compatibility_date": "2026-07-26",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
